APP_NAME="Zaloona Admin"
APP_ENV=local
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zaloona_admin
DB_USER=root
DB_PASS=
# Set to require TLS (e.g. certs/aiven-ca.pem). Leave unset for local MySQL.
DB_SSL_CA_PATH=

# The Node backend's public URL and its matching INTERNAL_API_KEY, used to upload
# salon logos to R2 (this container's own disk doesn't persist between deploys).
NODE_API_URL=https://zaloona.onrender.com
NODE_INTERNAL_API_KEY=
